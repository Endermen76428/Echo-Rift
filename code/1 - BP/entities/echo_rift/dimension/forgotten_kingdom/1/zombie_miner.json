{
  "format_version": "1.26.20",
  "minecraft:entity": {
    "description": {
      "identifier": "echo_rift:zombie_miner",
      "is_summonable": true,
      "is_spawnable": true,
      "spawn_category": "monster"
    },
    "components": {
      "minecraft:attack": { "damage": 3 },
      "minecraft:behavior.equip_item": { "priority": 2 },
      "minecraft:behavior.look_at_player": { "look_distance": 6, "priority": 8 },
      "minecraft:behavior.melee_box_attack": { "can_spread_on_fire": true, "priority": 4 },
      "minecraft:behavior.nearest_attackable_target": {
        "reselect_targets": true,
        "must_see": true,
        "within_radius": 25,
        "must_see_forget_duration": 17,
        "entity_types": [
          {
            "filters": {
              "any_of": [
                { "test": "is_family", "subject": "other", "value": "player" },
                { "test": "is_family", "subject": "other", "value": "snowgolem" },
                { "test": "is_family", "subject": "other", "value": "irongolem" }
              ]
            },
            "max_dist": 32
          }
        ],
        "priority": 2
      },
      "minecraft:behavior.random_look_around": { "priority": 9 },
      "minecraft:behavior.random_stroll": {
        "priority": 7,
        "speed_multiplier": 0.8
      },
      "minecraft:movement": {
        "value": 0.23
      },
      "minecraft:can_climb": {},
      "minecraft:collision_box": { "height": 1.9, "width": 0.6 },
      "minecraft:conditional_bandwidth_optimization": {},
      "minecraft:health": { "max": 20, "value": 20 },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "cause": "lava",
            "damage_per_tick": 4,
            "filters": { "test": "in_lava" }
          }
        ]
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:jump.static": {},
      "minecraft:movement.basic": {},
      "minecraft:nameable": {},
      "minecraft:navigation.walk": {
        "can_break_doors": true,
        "is_amphibious": true,
        "can_pass_doors": true,
        "can_walk": true
      },
      "minecraft:physics": {},
      "minecraft:pushable_by_entity": {},
      "minecraft:pushable_by_block": {},
      "minecraft:type_family": { "family": [ "monster", "zombie", "mob", "memory_fragment" ] },
      "minecraft:loot": { "table": "loot_tables/echo_rift/entity/dimension/forgotten_kingdom/zombie_miner.json" },
      "minecraft:experience_reward": {
        "on_death": {
          "expression": "query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0",
          "version": 13
        }
      }
    },
    "component_groups": {
      "minecraft:can_have_equipment": { "minecraft:equipment": { "table": "loot_tables/echo_rift/entity/dimension/forgotten_kingdom/zombie_miner_equip.json" } }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            // "minecraft:on_foot",
            "minecraft:can_have_equipment"
          ]
        }
      }
    }
  }
}
